# Neon Database Connection String
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require

# Server Port
PORT=3001

# Chave para assinar as sessões de login (gere uma longa e aleatória, ex.: openssl rand -base64 32)
SESSION_SECRET=

# Senha provisória do usuário "admin" criado no primeiro boot (opcional; se vazia, é gerada e exibida no log)
ADMIN_PASSWORD=

# Fuso horário do negócio (opcional)
APP_TIMEZONE=America/Sao_Paulo

# IA para cadastro de peças por foto (Anthropic)
ANTHROPIC_API_KEY=
# Modelo opcional (padrão: claude-opus-5-5)
# ANTHROPIC_MODEL=

# Loja online / Instagram
LOJA_NOME=Apega Desapega Brechó
# Usuário do Instagram (sem @) para o botão "Comprar pelo Instagram"
LOJA_INSTAGRAM=
# WhatsApp com DDI e DDD, só números (opcional), ex.: 5554999999999
LOJA_WHATSAPP=
# Endereço público fixo (recomendado com domínio próprio), ex.: https://loja.seubrecho.com.br
PUBLIC_URL=
# Código da meta tag de verificação de domínio do Meta (opcional)
FACEBOOK_DOMAIN_VERIFICATION=
